{
  "name": "gpmot-testes",
  "private": true,
  "description": "Testes do GPMOT/UFSM — Gestão de Portfólio: tela, banco e modo online",
  "scripts": {
    "preparar": "esbuild --bundle --format=esm --platform=browser node_modules/@supabase/supabase-js/dist/index.mjs --outfile=supabase-esm.js",
    "tela": "node tela.cjs",
    "banco": "bash banco.sh",
    "online": "node online.cjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "esbuild": "^0.25.0",
    "pg": "^8.13.0",
    "playwright": "^1.50.0"
  }
}
